{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent foreground quality review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "note",
    "variants"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "note": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant",
          "items"
        ],
        "properties": {
          "variant": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "status",
                "reasons",
                "metrics",
                "generated_sha256"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "rejected",
                    "needs_visual_review"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "metrics": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "foreground_coverage",
                    "min_local_coverage",
                    "iou",
                    "change"
                  ],
                  "properties": {
                    "foreground_coverage": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "min_local_coverage": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "iou": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "change": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "generated_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
