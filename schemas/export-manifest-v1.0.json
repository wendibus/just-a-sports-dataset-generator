{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Export manifest v1.0",
  "type": "object",
  "required": [
    "exporter",
    "schema_version",
    "application_version",
    "sport",
    "labels",
    "class_mapping",
    "reco_trainer_revision",
    "formats",
    "scene_splits",
    "sources_sha256",
    "files_sha256",
    "run",
    "renderers",
    "environment"
  ],
  "properties": {
    "exporter": {
      "type": "object",
      "required": ["plugin_id", "version", "plugin_api", "kind", "capabilities"],
      "properties": {
        "plugin_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "plugin_api": {"type": "integer", "minimum": 1},
        "kind": {"const": "exporter"},
        "capabilities": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "schema_version": {
      "const": "1.0"
    },
    "application_version": {
      "type": "string",
      "minLength": 1
    },
    "sport": {
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "class_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Class mapping",
        "type": "object",
        "required": [
          "label",
          "yolo_id",
          "coco_id"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "yolo_id": {
            "type": "integer",
            "minimum": 0
          },
          "coco_id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "reco_trainer_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "formats": {
      "type": "array",
      "items": {
        "enum": [
          "coco",
          "yolo"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scene_splits": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "train",
          "val",
          "test"
        ]
      }
    },
    "sources_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "files_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "run": {
      "type": [
        "object",
        "null"
      ]
    },
    "renderers": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Renderer provenance",
        "type": "object",
        "required": [
          "job_id",
          "id",
          "version",
          "seed",
          "assets"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Runtime",
      "type": "object",
      "required": [
        "python",
        "pillow",
        "system",
        "machine"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "pillow": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
