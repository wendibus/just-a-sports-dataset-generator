{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wendibus/just-a-sports-dataset-generator/schemas/sport-equipment-v1.0.json",
  "title": "Ball and referee appearance catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "season", "note", "sports"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "season": {"type": "string"},
    "note": {"type": "string"},
    "sports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basketball", "football", "futsal"],
      "properties": {
        "basketball": {"$ref": "#/$defs/sport"},
        "football": {"$ref": "#/$defs/sport"},
        "futsal": {"$ref": "#/$defs/sport"}
      }
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "range": {
      "type": "array",
      "items": {"type": "number", "exclusiveMinimum": 0},
      "minItems": 2,
      "maxItems": 2
    },
    "observed": {"type": "array", "items": {"type": "string"}},
    "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "sport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ball", "referee"],
      "properties": {
        "ball": {
          "type": "object",
          "additionalProperties": false,
          "required": ["regulation", "designs"],
          "properties": {
            "regulation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["size", "circumference_cm", "mass_g", "source", "verified"],
              "properties": {
                "size": {"type": "integer", "minimum": 1},
                "circumference_cm": {"$ref": "#/$defs/range"},
                "mass_g": {"$ref": "#/$defs/range"},
                "pressure_atm": {"$ref": "#/$defs/range"},
                "bounce": {"type": "string"},
                "variants": {"type": "array", "items": {"type": "object"}},
                "source": {"type": "string", "minLength": 1},
                "verified": {
                  "type": "boolean",
                  "description": "true when checked against the primary rules document"
                }
              }
            },
            "designs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "base", "weight"],
                "properties": {
                  "id": {"$ref": "#/$defs/id"},
                  "description": {"type": "string"},
                  "base": {"$ref": "#/$defs/color"},
                  "panels": {"anyOf": [{"$ref": "#/$defs/color"}, {"type": "null"}]},
                  "seams": {"anyOf": [{"$ref": "#/$defs/color"}, {"type": "null"}]},
                  "accents": {"type": "array", "items": {"$ref": "#/$defs/color"}},
                  "weight": {"type": "number", "exclusiveMinimum": 0},
                  "observed_in": {"$ref": "#/$defs/observed"}
                }
              }
            }
          }
        },
        "referee": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rules", "kits"],
          "properties": {
            "rules": {"type": "string"},
            "kits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "shirt", "sleeves", "pattern", "accent", "lower", "lower_color", "socks", "weight"],
                "properties": {
                  "id": {"$ref": "#/$defs/id"},
                  "shirt": {"$ref": "#/$defs/color"},
                  "sleeves": {"$ref": "#/$defs/color"},
                  "pattern": {"enum": ["plain", "vertical_stripes", "chest_pockets"]},
                  "accent": {"anyOf": [{"$ref": "#/$defs/color"}, {"type": "null"}]},
                  "lower": {"enum": ["trousers", "shorts"]},
                  "lower_color": {"$ref": "#/$defs/color"},
                  "socks": {"$ref": "#/$defs/color"},
                  "weight": {"type": "number", "exclusiveMinimum": 0},
                  "observed_in": {"$ref": "#/$defs/observed"}
                }
              }
            }
          }
        }
      }
    }
  }
}
