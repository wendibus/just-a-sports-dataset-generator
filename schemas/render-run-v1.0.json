{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Render run v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "application_version",
    "recipe",
    "recipe_sha256",
    "renderer",
    "renderer_version",
    "assets",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "application_version": {
      "type": "string",
      "minLength": 1
    },
    "recipe": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Normalized recipe",
      "type": "object",
      "required": [
        "schema_version",
        "name",
        "sport",
        "seed",
        "scenes",
        "frames_per_scene",
        "width",
        "height",
        "annotations",
        "labels"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sport": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "scenes": {
          "type": "integer",
          "minimum": 1
        },
        "frames_per_scene": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "renderer": {
      "type": "string",
      "minLength": 1
    },
    "renderer_version": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Completed job",
        "type": "object",
        "required": [
          "job_id",
          "seed",
          "frames"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "frames": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
