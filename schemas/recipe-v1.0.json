{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wendibus/just-a-sports-dataset-generator/schemas/recipe-v1.0.json",
  "title": "Sports dataset recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "sport", "seed", "scenes", "frames_per_scene", "resolution", "annotations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "sport": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "scenes": {"type": "integer", "minimum": 1},
    "frames_per_scene": {"type": "integer", "minimum": 1},
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["bounding_boxes", "instance_masks", "semantic_masks", "keypoints", "depth"]}
    }
  }
}

