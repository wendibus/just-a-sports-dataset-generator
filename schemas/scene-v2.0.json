{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Renderer scene v2.0",
  "type": "object",
  "required": [
    "schema_version",
    "renderer",
    "renderer_version",
    "job_id",
    "sport",
    "seed",
    "labels",
    "resolution",
    "requested_annotations",
    "annotation_semantics",
    "assets",
    "frames"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "renderer": {
      "type": "string",
      "minLength": 1
    },
    "renderer_version": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sport": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolution": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "requested_annotations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "annotation_semantics": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Frame",
        "type": "object",
        "required": [
          "frame_index",
          "rgb",
          "instance_ids",
          "objects"
        ],
        "properties": {
          "frame_index": {
            "type": "integer",
            "minimum": 0
          },
          "rgb": {
            "type": "string",
            "minLength": 1
          },
          "instance_ids": {
            "type": "string",
            "minLength": 1
          },
          "objects": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "Scene object",
              "type": "object",
              "required": [
                "instance_id",
                "class_id",
                "label",
                "bbox_xywh",
                "visible_area"
              ],
              "properties": {
                "instance_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                },
                "class_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox_xywh": {
                  "anyOf": [
                    {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        }
                      ],
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "visible_area": {
                  "type": "integer",
                  "minimum": 0
                },
                "amodal_bbox_xywh": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
