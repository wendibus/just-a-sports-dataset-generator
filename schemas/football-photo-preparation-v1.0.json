{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "football-photo-preparation-v1.0.json",
  "title": "Selected real football photograph preparation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sport",
    "stage",
    "production_enabled",
    "requested_count",
    "image_size",
    "source_size",
    "source_crop_xyxy",
    "source_sha256",
    "background_sha256",
    "rights",
    "camera",
    "labels",
    "goals",
    "annotation_policy",
    "pending"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sport": {
      "const": "football"
    },
    "stage": {
      "const": "photo_selected_scale_estimated"
    },
    "production_enabled": {
      "const": false
    },
    "requested_count": {
      "type": "integer",
      "minimum": 1
    },
    "image_size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "source_size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "source_crop_xyxy": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 4,
      "maxItems": 4
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "background_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "title",
        "source",
        "license",
        "license_url",
        "changes"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "const": "CC BY 2.0"
        },
        "license_url": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "metric_ground_truth",
        "assumed_goal_height_m",
        "assumed_camera_height_m",
        "goal_ground_y_px",
        "goal_pixels_per_metre",
        "horizon_y_px",
        "placement_bounds_xyxy",
        "restriction",
        "limitations"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "metric_ground_truth": {
          "const": false
        },
        "assumed_goal_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "assumed_camera_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "goal_ground_y_px": {
          "type": "number"
        },
        "goal_pixels_per_metre": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "horizon_y_px": {
          "type": "number"
        },
        "placement_bounds_xyxy": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "restriction": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "labels": {
      "const": [
        "ball",
        "player",
        "goalkeeper",
        "referee",
        "goal"
      ]
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source_xyxy",
          "bbox"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_xyxy": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "annotation_policy": {
      "type": "string",
      "minLength": 1
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
