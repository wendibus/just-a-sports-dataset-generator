{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native annotations v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "sport",
    "labels",
    "seed",
    "split",
    "resolution",
    "bbox_convention",
    "frames"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "sport": {
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "split": {
      "enum": [
        "train",
        "val",
        "test"
      ]
    },
    "resolution": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "bbox_convention": {
      "type": "string",
      "minLength": 1
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Native frame",
        "type": "object",
        "required": [
          "frame_index",
          "image_name",
          "instance_ids",
          "objects",
          "visible_annotations"
        ],
        "properties": {
          "frame_index": {
            "type": "integer",
            "minimum": 0
          },
          "image_name": {
            "type": "string",
            "minLength": 1
          },
          "instance_ids": {
            "type": "string",
            "minLength": 1
          },
          "objects": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "Identity",
              "type": "object",
              "required": [
                "instance_id",
                "class_id",
                "label"
              ],
              "properties": {
                "instance_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                },
                "class_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "visible_annotations": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "Visible annotation",
              "type": "object",
              "required": [
                "instance_id",
                "class_id",
                "label",
                "bbox_xywh",
                "visible_area",
                "rle_counts"
              ],
              "properties": {
                "instance_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                },
                "class_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox_xywh": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                },
                "visible_area": {
                  "type": "integer",
                  "minimum": 1
                },
                "rle_counts": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
